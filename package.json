{
  "name": "stepbook",
  "version": "1.1.0",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon server/index.js",
    "dev:client": "npm run --prefix client dev",
    "build": "npm run --prefix client build",
    "start": "node server/index.js",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Step-by-step visual guide creator with image annotations",
  "dependencies": {
    "adm-zip": "^0.5.16",
    "archiver": "^7.0.1",
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "multer": "^2.0.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^40.4.1",
    "electron-builder": "^26.7.0",
    "nodemon": "^3.1.11"
  },
  "build": {
    "appId": "com.stepbook.app",
    "productName": "Stepbook",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "server/**/*",
      "client/dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ]
  }
}
